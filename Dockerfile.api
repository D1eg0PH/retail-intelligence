FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY ["Eleventa.Contracts/Eleventa.Contracts.csproj", "Eleventa.Contracts/"]
COPY ["RetailIntelligence.Api/RetailIntelligence.Api.csproj", "RetailIntelligence.Api/"]
RUN dotnet restore "RetailIntelligence.Api/RetailIntelligence.Api.csproj"

COPY . .
RUN dotnet publish "RetailIntelligence.Api/RetailIntelligence.Api.csproj" \
    --configuration Release \
    --no-restore \
    --output /app/publish \
    /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_HTTP_PORTS=10000
EXPOSE 10000
ENTRYPOINT ["dotnet", "RetailIntelligence.Api.dll"]
